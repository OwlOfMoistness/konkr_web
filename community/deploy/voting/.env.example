# Copy to .env in this directory. This file is read by Compose, never the static site.
# Use new, independent random hex values for these two secrets; retain them across updates.
VOTING_DATABASE_PASSWORD=
VOTING_SECRET=
# Origins only: no trailing slash, repository path, query or fragment.
VOTING_API_ORIGIN=https://konkr-community.hoothoot.dev
VOTING_SITE_ORIGIN=https://owlofmoistness.github.io
# The new konkr-community tunnel token; never use the other application's token.
CLOUDFLARE_TUNNEL_TOKEN=
# Set to a release/commit identifier before building if you want named rollback images.
VOTING_IMAGE_TAG=local

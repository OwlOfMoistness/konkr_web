{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "engine/**/*.ts", "runtime/**/*.ts", "scripts/**/*.ts", "shared/**/*.ts", "tests/**/*.ts", "web/**/*.ts", "worker/**/*.ts"],
  "exclude": ["node_modules", ".runtime", ".data", ".scratch"]
}
